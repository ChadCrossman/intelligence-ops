PORT=3150

# API-only secrets. Do not prefix these with VITE_ or use them from apps/web.
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=
NEWS_API_KEY=

# Use deterministic mock results when provider credentials or feed URLs are absent.
MOCK_SEARCH_PROVIDERS=true

# Comma-separated RSS/feed source URLs for non-credentialed providers.
RSS_SOURCE_URLS=
REGULATORY_FEED_URLS=
GOVERNANCE_BLOG_FEED_URLS=
VENDOR_BLOG_FEED_URLS=
REDDIT_SUBREDDITS=artificial,MachineLearning,technology,Futurology

# Future integrations
STORAGE_PROVIDER=file
INTELLIGENCE_OPS_DATABASE_URL=postgresql://postgres<Password>@localhost:5432/PublishWeaverIntelligenceOps?sslmode=disable
LABELS_DATABASE_URL=postgresql://postgres<Password>@localhost:5432/PublishWeaver?sslmode=disable
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
